{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Make Clean PPTX deck spec (deck.json)",
  "description": "The file read by scripts/build_deck.py --spec. Details and examples: references/spec-reference.md. Unknown keys are reported here as errors; build_deck.py warns about them (spec, slide and insert keys) or ignores them (inside fill values). Check a spec without third-party packages: scripts/validate_spec.py deck.json.",
  "type": "object",
  "required": ["slides"],
  "additionalProperties": false,
  "properties": {
    "output": {"type": "string", "minLength": 1, "description": "Path of the .pptx to write (--out overrides it). Default: deck.pptx."},
    "language": {"type": "string", "minLength": 1, "description": "Language tag of the content, e.g. en-GB, fr-FR."},
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "description": "File properties. Not written in skeleton mode.",
      "properties": {
        "title": {"type": "string"},
        "author": {"type": "string"},
        "subject": {"type": "string"},
        "keywords": {"type": "string"},
        "comments": {"type": "string"}
      }
    },
    "theme": {"type": "string", "minLength": 1, "description": "A .thmx, .potx, .pptx or theme .xml file whose colours and fonts replace the deck's theme."},
    "theme_fonts_fallback": {
      "description": "Font used when the brand font is unlikely to be available: a name, or {major, minor}. Ignored without 'theme'.",
      "anyOf": [
        {"type": "string"},
        {"type": "object", "additionalProperties": false, "properties": {"major": {"type": "string"}, "minor": {"type": "string"}}}
      ]
    },
    "logo": {"type": ["string", "null"], "pattern": "^$|\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ss][Vv][Gg])$", "description": "PNG, JPG or SVG file put in the Logo slot of the covers and the closing slide."},
    "logo_alt": {"type": "string", "description": "Alt text of the logo, normally the brand name. Without it the logo is decorative."},
    "skeleton": {"type": "boolean", "description": "true builds the deck without the user's content (same as --skeleton)."},
    "slides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slide"}}
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["id"]}, {"required": ["slide"]}],
      "properties": {
        "source": {"$ref": "#/$defs/source", "description": "Library to clone from. Default: layouts."},
        "id": {"type": "string", "minLength": 1, "description": "Index id, e.g. L-32. Preferred over 'slide'."},
        "slide": {"type": "integer", "minimum": 1, "description": "1-based position in the library."},
        "fill": {"$ref": "#/$defs/fill"},
        "insert": {"type": "array", "items": {"$ref": "#/$defs/insert"}},
        "notes": {"type": "string", "description": "Speaker notes."},
        "keep_unfilled": {"type": "boolean", "description": "Keep optional fields left unfilled."},
        "hidden": {"type": "boolean", "description": "Skip this slide."}
      }
    },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "anyOf": [{"required": ["id"]}, {"required": ["slide"]}],
      "properties": {
        "source": {"$ref": "#/$defs/source", "description": "Default: visuals."},
        "id": {"type": "string", "minLength": 1, "description": "Index id of the visual, e.g. V-COM-01."},
        "slide": {"type": "integer", "minimum": 1},
        "component": {"type": "string", "minLength": 1, "description": "Top-level shape or group to copy; in the bundled library, the id itself."},
        "into": {"type": "string", "minLength": 1, "description": "Frame field of the layout replaced by the visual, e.g. Content Area."},
        "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}, "description": "[x, y, w, h] in percent of the slide, instead of 'into'."},
        "fit": {"enum": ["contain", "stretch"]},
        "fill": {"$ref": "#/$defs/fill"},
        "keep_unfilled": {"type": "boolean"}
      }
    },
    "source": {"enum": ["layouts", "visuals", "design", "shapes"]},
    "fill": {
      "type": "object",
      "description": "Field name (or '#3', or a {{token}}) -> value.",
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "value": {
      "description": "null or \"\" deletes the shape.",
      "anyOf": [
        {"type": ["null", "string", "number"]},
        {"$ref": "#/$defs/paragraphs"},
        {"$ref": "#/$defs/table"},
        {"$ref": "#/$defs/image"},
        {"$ref": "#/$defs/icon"},
        {"$ref": "#/$defs/svg"},
        {"$ref": "#/$defs/chart"},
        {"$ref": "#/$defs/waterfall"},
        {"$ref": "#/$defs/gantt"},
        {"$ref": "#/$defs/rich"}
      ]
    },
    "paragraphs": {
      "type": "array",
      "description": "One paragraph per item.",
      "items": {
        "anyOf": [
          {"type": ["string", "number"]},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {"text": {"type": "string"}, "level": {"type": ["integer", "null"], "minimum": 0, "maximum": 8}}
          }
        ]
      }
    },
    "table": {
      "type": "array",
      "minItems": 1,
      "description": "Rows of cells; the first row is the header.",
      "items": {"type": "array", "items": {"type": ["string", "number", "null"]}}
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "Image file; an .svg file is converted to native shapes."},
        "alt": {"type": "string"},
        "credit": {"type": "string"},
        "fit": {"enum": ["cover", "contain"]},
        "decorative": {"type": "boolean"},
        "mode": {"$ref": "#/$defs/svg_mode"},
        "color": {"$ref": "#/$defs/colour"},
        "weight": {"type": "number", "minimum": 0}
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon"],
      "properties": {
        "icon": {"type": "string", "minLength": 1, "description": "lucide:<name>, local:<file.svg> or another source of find_icon.py."},
        "color": {"$ref": "#/$defs/colour"},
        "mode": {"$ref": "#/$defs/svg_mode"},
        "weight": {"type": "number", "minimum": 0},
        "alt": {"type": "string"}
      }
    },
    "svg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["svg"],
      "properties": {
        "svg": {"type": "string", "pattern": "\\.[Ss][Vv][Gg]$"},
        "color": {"$ref": "#/$defs/colour"},
        "mode": {"$ref": "#/$defs/svg_mode"},
        "weight": {"type": "number", "minimum": 0},
        "alt": {"type": "string"}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series"],
      "properties": {
        "categories": {"$ref": "#/$defs/categories"},
        "series": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": ["number", "null"]}}}
      }
    },
    "waterfall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waterfall"],
      "properties": {
        "categories": {"$ref": "#/$defs/categories"},
        "waterfall": {"type": "array", "items": {"type": "number"}},
        "totals": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "gantt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gantt"],
      "properties": {
        "categories": {"$ref": "#/$defs/categories"},
        "gantt": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
      }
    },
    "rich": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": {"anyOf": [{"type": ["null", "string", "number"]}, {"$ref": "#/$defs/paragraphs"}]},
        "fill": {"$ref": "#/$defs/colour"},
        "color": {"$ref": "#/$defs/colour"},
        "at": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}, "description": "[x%, y%] in the Plot Area, 0,0 = bottom left."}
      }
    },
    "categories": {"type": "array", "items": {"type": ["string", "number"]}},
    "svg_mode": {"enum": ["mono", "grey", "keep"]},
    "colour": {
      "description": "Theme colour token or alias (lower case).",
      "enum": ["ink", "ink2", "muted", "line", "surface", "paper", "a1", "a2", "a3", "a4", "a5", "a6",
               "black", "white", "dark", "light", "grey", "gray",
               "accent1", "accent2", "accent3", "accent4", "accent5", "accent6"]
    }
  }
}
