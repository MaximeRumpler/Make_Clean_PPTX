{
  "_comment": "Neutral design system. Every colour is drawn with its 'hex' value, then tools/post.py rewrites it as the theme reference in 'scheme' so that applying another PowerPoint theme recolours the whole library. Hex values must stay unique. The theme font pair is a style token (../style-tokens.json).",
  "theme": {
    "name": "Make Clean Neutral",
    "colors": {
      "dk1": "111111",
      "lt1": "FFFFFF",
      "dk2": "404040",
      "lt2": "F2F2F2",
      "accent1": "1F1F1F",
      "accent2": "595959",
      "accent3": "8C8C8C",
      "accent4": "B3B3B3",
      "accent5": "D0D0D0",
      "accent6": "E6E6E6",
      "hlink": "404040",
      "folHlink": "8C8C8C"
    }
  },
  "colors": {
    "ink": {
      "hex": "111111",
      "scheme": "tx1",
      "use": "titles, key numbers, primary text"
    },
    "ink2": {
      "hex": "404040",
      "scheme": "tx2",
      "use": "body text"
    },
    "muted": {
      "hex": "6E6E6E",
      "scheme": "tx1",
      "lumMod": 50000,
      "lumOff": 40000,
      "use": "captions, labels, footers (5.1:1 on white)"
    },
    "line": {
      "hex": "D9D9D9",
      "scheme": "bg1",
      "lumMod": 85000,
      "use": "rules, borders, gridlines"
    },
    "surface": {
      "hex": "F2F2F2",
      "scheme": "bg2",
      "use": "cards, panels, frames"
    },
    "paper": {
      "hex": "FFFFFF",
      "scheme": "bg1",
      "use": "slide background, text on dark"
    },
    "a1": {
      "hex": "1F1F1F",
      "scheme": "accent1",
      "use": "emphasis, main data series, dark panels"
    },
    "a2": {
      "hex": "595959",
      "scheme": "accent2",
      "use": "second series"
    },
    "a3": {
      "hex": "8C8C8C",
      "scheme": "accent3",
      "use": "third series, comparison"
    },
    "a4": {
      "hex": "B3B3B3",
      "scheme": "accent4",
      "use": "fourth series, reference"
    },
    "a5": {
      "hex": "D0D0D0",
      "scheme": "accent5",
      "use": "fifth series, light fills"
    },
    "a6": {
      "hex": "E6E6E6",
      "scheme": "accent6",
      "use": "sixth series, faint fills"
    }
  },
  "fonts": {
    "heading": {
      "draw": "MCP Heading",
      "theme": "+mj-lt"
    },
    "body": {
      "draw": "MCP Body",
      "theme": "+mn-lt"
    }
  },
  "type": {
    "display": {
      "size": 54,
      "font": "heading",
      "bold": true,
      "color": "ink"
    },
    "hero": {
      "size": 40,
      "font": "heading",
      "bold": true,
      "color": "ink"
    },
    "title": {
      "size": 26,
      "font": "heading",
      "bold": true,
      "color": "ink"
    },
    "lead": {
      "size": 16,
      "font": "body",
      "bold": false,
      "color": "ink2"
    },
    "h3": {
      "size": 16,
      "font": "heading",
      "bold": true,
      "color": "ink"
    },
    "body": {
      "size": 14,
      "font": "body",
      "bold": false,
      "color": "ink2"
    },
    "small": {
      "size": 12,
      "font": "body",
      "bold": false,
      "color": "ink2"
    },
    "label": {
      "size": 10,
      "font": "body",
      "bold": true,
      "color": "muted",
      "caps": true
    },
    "caption": {
      "size": 10,
      "font": "body",
      "bold": false,
      "color": "muted"
    },
    "number": {
      "size": 44,
      "font": "heading",
      "bold": true,
      "color": "ink"
    }
  },
  "grid": {
    "slide": {
      "w": 13.333,
      "h": 7.5
    },
    "margin": {
      "x": 0.6,
      "top": 0.45
    },
    "kicker": {
      "y": 0.45,
      "h": 0.3
    },
    "title": {
      "y": 0.75,
      "h": 0.95
    },
    "lead": {
      "y": 1.72,
      "h": 0.42
    },
    "content": {
      "y": 2.2,
      "h": 4.55
    },
    "footer": {
      "y": 7.0,
      "h": 0.25
    },
    "gutter": 0.3
  }
}
